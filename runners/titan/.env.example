# Copy to .env, chmod 0600, and fill in the token.
# Runner images publish independent SemVer tags; Renovate can update this value.
# Use ./deploy.sh up for initial registration or identity changes; blank
# TITAN_RUNNER_TOKEN after successful registration and run ./deploy.sh up again.
# VM network requirements: docs/vm-deployment.md

TITAN_RUNNER_IMAGE=ghcr.io/pintjesb/titan-stocks-runner:1.0.0
TITAN_RUNNER_REPO_URL=https://github.com/PintjesB/titan-stocks
TITAN_RUNNER_NAME=titan-ci
TITAN_RUNNER_LABELS=titan-ci
TITAN_RUNNER_TOKEN=

# Optional independent listener for workflow-lint and renovate-config.
# Start explicitly with --profile ci-light; use a fresh registration token.
TITAN_RUNNER_LIGHT_NAME=titan-ci-light
TITAN_RUNNER_LIGHT_TOKEN=

# Optional path overrides:
# TITAN_RUNNER_STATE_DIR=/var/lib/titan-runner/state
# TITAN_RUNNER_RUNTIME_DIR=/var/lib/titan-runner/runtime
# TITAN_RUNNER_BROWSER_DIR=/var/lib/titan-runner/browser
# TITAN_RUNNER_ROOT=/opt/actions-runner

# Optional non-secret evidence routing; OIDC identity comes from the GitHub job.
TITAN_EVIDENCE_BASE_URL=""
TITAN_EVIDENCE_AUDIENCE=""
