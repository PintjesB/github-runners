# Runner images publish independent SemVer tags; Renovate can update this value.
OPORTUNIST_RUNNER_IMAGE=ghcr.io/pintjesb/oportunist-runner:1.0.0
OPORTUNIST_RUNNER_REPO_URL=https://github.com/PintjesB/oportunist
OPORTUNIST_RUNNER_NAME=oportunist-ci
OPORTUNIST_RUNNER_LABELS=oportunist-ci,codex

# Short-lived GitHub Actions registration token. Required only for first
# registration or when runner identity changes. Blank it after registration.
OPORTUNIST_RUNNER_TOKEN=

# Optional independent listener for workflow-lint and renovate-config.
# Start explicitly with --profile ci-light; use a fresh registration token.
OPORTUNIST_RUNNER_LIGHT_NAME=oportunist-ci-light
OPORTUNIST_RUNNER_LIGHT_TOKEN=

# Optional non-secret evidence routing; OIDC identity comes from the GitHub job.
TITAN_EVIDENCE_BASE_URL=""
TITAN_EVIDENCE_AUDIENCE=""
