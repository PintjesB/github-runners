{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":enableVulnerabilityAlertsWithLabel('security')",
    ":rebaseStalePrs",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Brussels",
  "labels": [
    "renovate"
  ],
  "platformAutomerge": false,
  "automergeType": "pr",
  "ignoreTests": false,
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**"
  ],
  "packageRules": [
    {
      "description": "Automerge Python dependency patches after CI",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "matchFileNames": [
        "runners/titan/**",
        "runners/oportunist/**"
      ]
    },
    {
      "description": "Automerge npm dependency patches after CI",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "matchFileNames": [
        "runners/titan/**",
        "runners/oportunist/**"
      ]
    },
    {
      "description": "Automerge npm lockfile maintenance after CI",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "automerge": true,
      "matchFileNames": [
        "runners/titan/**",
        "runners/oportunist/**"
      ]
    },
    {
      "description": "Automerge stable Python and npm minors after CI",
      "matchManagers": [
        "pip_requirements",
        "npm"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "matchCurrentVersion": "/^[1-9]\\d*\\.\\d+(?:\\.\\d+)?$/",
      "automerge": true,
      "matchFileNames": [
        "runners/titan/**",
        "runners/oportunist/**"
      ]
    },
    {
      "description": "Automerge explicitly tested validation Actions after CI",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/setup-node"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Automerge actionlint updates exercised by workflow lint",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "rhysd/actionlint"
      ],
      "matchFileNames": [
        ".github/workflows/workflow-lint.yml"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Keep untested and privileged GitHub Actions manual",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "!actions/setup-node"
      ],
      "automerge": false
    },
    {
      "description": "Keep CI runtime toolchains manual",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "python",
        "node"
      ],
      "automerge": false
    },
    {
      "description": "Require Dependency Dashboard approval for stateful database and datastore images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^(?:[^/]+\\/)*(?:postgres|postgresql|redis|valkey|mariadb|mysql|mongo|mongodb|elasticsearch|opensearch|influxdb|clickhouse|cockroachdb|couchdb|timescaledb|postgres-documentdb)$/",
        "mcr.microsoft.com/mssql/server"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Keep the baked Codex CLI update manual",
      "matchPackageNames": [
        "@openai/codex"
      ],
      "automerge": false
    },
    {
      "description": "Keep GitHub Actions runner updates manual",
      "matchPackageNames": [
        "actions/runner"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true,
      "prBodyNotes": [
        "The runner release uses architecture-specific SHA-256 pins. Refresh RUNNER_SHA256_ARM64 and RUNNER_SHA256_X64 from the same actions/runner release before merging."
      ]
    },
    {
      "description": "Keep pre-1.0 and prerelease dependency minors manual",
      "matchManagers": [
        "pip_requirements",
        "npm"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "matchCurrentVersion": "!/^[1-9]\\d*\\.\\d+(?:\\.\\d+)?$/",
      "automerge": false
    },
    {
      "description": "Keep major dependency updates manual",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Keep manual updates out of automatic dependency groups",
      "matchJsonata": [
        "automerge = false"
      ],
      "groupName": null,
      "groupSlug": null
    },
    {
      "description": "Review artifact transport Action majors together",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "actions/upload-artifact",
        "actions/download-artifact"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": "GitHub artifact transport major migration",
      "groupSlug": "github-artifact-transport-major",
      "automerge": false
    },
    {
      "description": "Label dependency PRs Renovate will auto-merge",
      "matchJsonata": [
        "automerge = true"
      ],
      "addLabels": [
        "auto merge"
      ]
    },
    {
      "description": "Label dependency PRs that require manual merge",
      "matchJsonata": [
        "automerge = false"
      ],
      "addLabels": [
        "manual merge"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the OpenAI Codex CLI baked into both runner images",
      "managerFilePatterns": [
        "/^runners\\/(?:oportunist|titan)\\/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG CODEX_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "@openai/codex",
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Track the GitHub Actions runner version baked into both runner images",
      "managerFilePatterns": [
        "/^runners\\/(?:oportunist|titan)\\/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG RUNNER_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "actions/runner",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Track the digest-pinned actionlint Docker image used by workflow lint",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/workflow-lint\\.yml$/"
      ],
      "matchStrings": [
        "ACTIONLINT_IMAGE: \"rhysd/actionlint:(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "depNameTemplate": "rhysd/actionlint",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "automerge": false,
  "internalChecksAsSuccess": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "groupName": null
  }
}
