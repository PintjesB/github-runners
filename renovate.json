{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":enableVulnerabilityAlertsWithLabel('security')",
    ":rebaseStalePrs",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Europe/Brussels",
  "labels": [
    "renovate"
  ],
  "platformAutomerge": false,
  "automergeType": "pr",
  "ignoreTests": false,
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**"
  ],
  "packageRules": [
    {
      "description": "Automerge Python patch updates after CI succeeds",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "Python patches",
      "automerge": true
    },
    {
      "description": "Automerge npm patch updates after CI succeeds",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "npm patches",
      "automerge": true
    },
    {
      "description": "Keep GitHub Actions updates manual",
      "matchManagers": [
        "github-actions"
      ],
      "automerge": false
    },
    {
      "description": "Keep Docker updates manual",
      "matchDatasources": [
        "docker"
      ],
      "automerge": false
    },
    {
      "description": "Keep the baked Codex CLI update manual",
      "matchPackageNames": [
        "@openai/codex"
      ],
      "automerge": false
    },
    {
      "description": "Require Dependency Dashboard approval for stateful database and datastore images",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^(?:[^/]+\\/)*(?:postgres|postgresql|redis|valkey|mariadb|mysql|mongo|mongodb|elasticsearch|opensearch|influxdb|clickhouse|cockroachdb|couchdb|timescaledb|postgres-documentdb)$/",
        "mcr.microsoft.com/mssql/server"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Keep major dependency updates manual",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Keep GitHub Actions runner updates manual",
      "matchPackageNames": [
        "actions/runner"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true,
      "prBodyNotes": [
        "The runner release uses architecture-specific SHA-256 pins. Refresh RUNNER_SHA256_ARM64 and RUNNER_SHA256_X64 from the same actions/runner release before merging."
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the OpenAI Codex CLI baked into both runner images",
      "managerFilePatterns": [
        "/^runners\\/(?:oportunist|titan)\\/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG CODEX_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "@openai/codex",
      "datasourceTemplate": "npm",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Track the GitHub Actions runner version baked into both runner images",
      "managerFilePatterns": [
        "/^runners\\/(?:oportunist|titan)\\/Dockerfile$/"
      ],
      "matchStrings": [
        "ARG RUNNER_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "actions/runner",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Track the digest-pinned actionlint Docker image used by workflow lint",
      "managerFilePatterns": [
        "/^\\.github\\/workflows\\/workflow-lint\\.yml$/"
      ],
      "matchStrings": [
        "ACTIONLINT_IMAGE: \"rhysd/actionlint:(?<currentValue>[^@\"]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "depNameTemplate": "rhysd/actionlint",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "automerge": false
}
